# Copy your Tiger Data PostgreSQL connection URL into .env.local.
# Keep the actual password out of this example file.
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=3000
STALE_AFTER_SECONDS=60
# Server-only: generate a random secret of at least 32 characters for signed
# anonymous reporter cookies and keyed abuse-control hashes. Never use VITE_.
REPORT_SECRET=
